# Home Assistant MCP Server - Environment Configuration

# Node environment (development, production, test)
NODE_ENV=production

# Home Assistant Configuration
HASS_HOST=http://homeassistant.local:8123
HASS_TOKEN=your_home_assistant_long_lived_access_token_here

# Server Configuration
PORT=3000
LOG_LEVEL=info

# Optional: WebSocket URL for advanced features
# HASS_SOCKET_URL=ws://homeassistant.local:8123/api/websocket
